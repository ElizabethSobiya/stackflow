# Copy to .env and adjust. docker compose reads this file automatically.

# Host port for the dev Postgres container.
# Set to something else (e.g. 55432) if you already run Postgres on 5432 —
# then point the API at it with DB_URL=jdbc:postgresql://localhost:55432/stackflow
STACKFLOW_DB_PORT=5432

# --- Backend (only needed when running the API outside docker compose) ---
# DB_URL=jdbc:postgresql://localhost:5432/stackflow
# DB_USERNAME=stackflow
# DB_PASSWORD=stackflow
# JWT_SECRET=change-me-to-at-least-32-bytes-of-random
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Deployed environments ---
# Most platforms inject a single DATABASE_URL; it is translated to JDBC automatically,
# so DB_URL/DB_USERNAME/DB_PASSWORD can be left unset there.
# DATABASE_URL=postgres://user:password@host:5432/stackflow
# PORT=8080                      # injected by Render / Railway / Heroku / Fly
# SPRING_PROFILES_ACTIVE=prod
# ENABLE_API_DOCS=false          # set true to expose Swagger UI in a deployed environment

# --- Frontend build ---
# Baked into the bundle at build time by scripts/generate-environment.mjs.
# Leave unset to keep the same-origin default (/api) used by the nginx image.
# API_BASE_URL=https://stackflow-api.onrender.com/api
